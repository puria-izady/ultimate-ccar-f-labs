# Copy this file to .env in this directory and fill it in once. Every lab notebook
# reads this same file, so you set your credential one time.
#
# You have a choice, because the Agent SDK runs the claude binary rather than
# calling the API itself, and so takes whichever credential that binary takes.
# Labs 1, 2 and 3 are Agent SDK labs and follow this file. Labs 4 and 6 run in a
# terminal and take the same choice there. Lab 5 is the one exception: it calls
# the Claude API directly, which a subscription cannot authenticate, so that lab
# needs a key whatever you pick here.
#
# On a Claude Pro, Max, Team or Enterprise subscription, leave both lines below
# blank and run `claude` once to sign in. The Agent SDK labs then draw on your
# subscription and cost you nothing beyond it.
#
# On API billing, put a key from the Claude Console in ANTHROPIC_API_KEY. A key
# outranks a subscription login, so blank this line out again to switch back.
#
# CLAUDE_CODE_OAUTH_TOKEN is the third way in, for a machine you would rather not
# sign in on: `claude setup-token` prints a year-long token tied to your
# subscription. Lab 4 hands that same token to GitHub as a secret.

ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Model aliases. Keep the literal ids here and nowhere else, so they can be
# swapped without touching a notebook.
LAB_MODEL=claude-sonnet-5
LAB_MODEL_SMALL=claude-haiku-4-5-20251001
